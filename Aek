-- Append Message Function
local function addMessage(sender, text, isAi)
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -20, 0, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = sender .. ": " .. text
    msgLabel.TextColor3 = isAi and textColor or Color3.fromRGB(220, 220, 220)
    msgLabel.TextSize = 16
    msgLabel.Font = Enum.Font.SourceSans
    msgLabel.TextWrapped = true
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Parent = ChatScroll

    msgLabel.Size = UDim2.new(1, -20, 0, msgLabel.TextBounds.Y + 5)
end

-- Local Offline AI Engine (ตอบทันที ไม่ย้อนถาม)
local function getAiResponse(query)
    local q = string.lower(query)
    if string.find(q, "สวัสดี") or string.find(q, "hello") or string.find(q, "bonjour") then
        return "สวัสดีครับ ผมคือ AI ประจำสคริปต์ เอกชอบสร้างสคริป ยินดีให้คำแนะนำทุกเรื่องครับ"
    elseif string.find(q, "สคริป") or string.find(q, "script") then
        return "สคริปต์นี้สร้างโดย เอกชอบสร้างสคริป รวบรวมฟังก์ชันสำหรับใช้งานได้ทุกแมพใน Roblox ครับ"
    elseif string.find(q, "ทำอะไรได้บ้าง") or string.find(q, "help") then
        return "ผมสามารถตอบคำถามทั่วไป ให้ข้อมูลเกี่ยวกับการใช้งานสคริปต์ บิน วิ่งเร็ว หรือวาร์ปได้ครับ"
    else
        return "รับทราบคำถาม: '" .. query .. "' ระบบกำลังประมวลผลข้อมูลและพร้อมช่วยเหลือคุณอย่างเต็มที่ครับ"
    end
end

local function onSend()
    local text = InputBox.Text
    if text ~= "" then
        addMessage("You", text, false)
        InputBox.Text = ""
        task.wait(0.2)
        local reply = getAiResponse(text)
        addMessage("AI", reply, true)
    end
end

SendBtn.MouseButton1Click:Connect(onSend)
InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then onSend() end
end)


